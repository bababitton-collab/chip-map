  "chokepoints": [
    {
      "id": "CPP1",
      "name": "Sterile fill-finish",
      "label": {
        "en": "sterile fill-finish"
      },
      "blurb": {
        "en": "The bottleneck is the needle, not the molecule: a sterile line takes years to build and qualify, and most of the capacity that exists is private or already spoken for."
      },
      "node_ids": [
        "siegfried",
        "catalent",
        "lly",
        "novo"
      ],
      "concentration": "Largely private; the biggest independent network, Catalent, was bought by Novo Holdings and its GLP-1 sites assigned to Novo Nordisk",
      "geography": "United States, Switzerland, Italy, Denmark",
      "dependents": [
        "lly",
        "novo",
        "amgen",
        "pfizer",
        "viking"
      ],
      "substitute": "None at scale inside the window; a new sterile line is built, validated and inspected before it fills anything",
      "substitution_time": "3-4 years",
      "source": "https://www.daily-remedy.com/the-bottleneck-is-the-needle/"
    },
    {
      "id": "CPP2",
      "name": "Injection contact components",
      "label": {
        "en": "injection contact components"
      },
      "blurb": {
        "en": "Stoppers, plungers, cartridges and syringes are the surface the drug touches, so each one is qualified to its molecule. The constraint is qualified capacity, not rubber."
      },
      "node_ids": [
        "west",
        "stevanato",
        "gerresheimer",
        "ypsomed",
        "corning"
      ],
      "concentration": "West's high-value components were 49% of its sales in Q2 2026 and GLP-1 elastomer alone about a tenth of company revenue",
      "geography": "United States, Germany, Italy, Switzerland",
      "dependents": [
        "lly",
        "novo",
        "amgen",
        "pfizer"
      ],
      "substitute": "A second supplier exists on paper, but requalifying a contact component is a regulatory change, not a purchase",
      "substitution_time": "18-36 months",
      "source": "https://www.sec.gov/Archives/edgar/data/0000105770/000010577026000097/exh991q22026earningsrelease.htm"
    },
    {
      "id": "CPP3",
      "name": "Peptide synthesis",
      "label": {
        "en": "peptide synthesis"
      },
      "blurb": {
        "en": "Semaglutide and its peers are peptides, and the independent capacity to make them at tonne scale sits with a very small number of Swiss houses."
      },
      "node_ids": [
        "bachem",
        "polypeptide",
        "lonza"
      ],
      "concentration": "Two listed independents of scale, both Swiss, plus the incretin makers' own in-house lines",
      "geography": "Switzerland, United States, Belgium",
      "dependents": [
        "lly",
        "novo",
        "viking"
      ],
      "substitute": "In-house synthesis, which the incumbents are building and which takes as long as any other plant",
      "substitution_time": "2-3 years",
      "source": "https://www.bachem.com/knowledge-center/glp-1-demand-for-peptide-manufacturers/"
    },
    {
      "id": "CPP4",
      "name": "Chinese CDMO exposure",
      "label": {
        "en": "Chinese CDMO exposure"
      },
      "blurb": {
        "en": "The BIOSECURE Act is law, so the constraint is no longer whether it passes but who ends up named and how fast work has to move. Reshoring is a queue for the same Western capacity everything else is queueing for."
      },
      "node_ids": [
        "wuxi_bio",
        "samsung_bio",
        "lonza",
        "fujifilm"
      ],
      "concentration": "A small number of non-China CDMOs able to absorb work at scale, against an incumbent that has been named on the Section 1260H list",
      "geography": "China, South Korea, Switzerland, Japan, United States",
      "dependents": [
        "lly",
        "novo",
        "amgen",
        "pfizer"
      ],
      "substitute": "Samsung Biologics, Lonza and Fujifilm, all of whom are adding capacity into the same demand",
      "substitution_time": "2-4 years",
      "source": "https://www.klgates.com/BIOSECURE-Act-What-You-Need-to-Know-1-20-2026"
    }
  ],
